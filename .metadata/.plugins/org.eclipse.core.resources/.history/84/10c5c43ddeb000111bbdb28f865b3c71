/* =========================================================
 * Initialization
 * ========================================================= */

void HL298_vInit(void)
{
    GPIOx_PinConfig_t L_xPinConfig;


    /* Motor 1 IN1 */
    L_xPinConfig.Port = M1_IN1_PORT;
    L_xPinConfig.Pin = M1_IN1_PIN;
    L_xPinConfig.Mode = GPIO_OUTPUT;
    L_xPinConfig.Speed = GPIO_LOW;
    L_xPinConfig.OutputType = GPIO_PUSH_PULL;
    L_xPinConfig.PullType = GPIO_NO_PULL;

    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 1 IN2 */
    L_xPinConfig.Pin = M1_IN2_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 2 IN1 */
    L_xPinConfig.Pin = M2_IN1_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 2 IN2 */
    L_xPinConfig.Pin = M2_IN2_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 3 IN1 */
    L_xPinConfig.Port = M3_IN1_PORT;
    L_xPinConfig.Pin = M3_IN1_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 3 IN2 */
    L_xPinConfig.Pin = M3_IN2_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 4 IN1 */
    L_xPinConfig.Port = M4_IN1_PORT;
    L_xPinConfig.Pin = M4_IN1_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Motor 4 IN2 */
    L_xPinConfig.Pin = M4_IN2_PIN;
    MGPIO_vPinInit(&L_xPinConfig);


    /* Stop motors initially */
    HL298_vStop();
}


