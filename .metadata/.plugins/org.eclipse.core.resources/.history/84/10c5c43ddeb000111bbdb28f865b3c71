/* =========================================================
 * Motor 1
 * ========================================================= */

static void HL298_vMotor1Forward(void)
{
    MGPIO_vSetPinValue(M1_IN1_PORT, M1_IN1_PIN, GPIO_HIGH);
    MGPIO_vSetPinValue(M1_IN2_PORT, M1_IN2_PIN, GPIO_LOW);
}

static void HL298_vMotor1Backward(void)
{
    MGPIO_vSetPinValue(M1_IN1_PORT, M1_IN1_PIN, GPIO_LOW);
    MGPIO_vSetPinValue(M1_IN2_PORT, M1_IN2_PIN, GPIO_HIGH);
}


