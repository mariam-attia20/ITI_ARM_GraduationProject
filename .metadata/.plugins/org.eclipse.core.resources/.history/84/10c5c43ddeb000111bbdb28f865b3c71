/* =========================================================
 * Forward
 * ========================================================= */

void HL298_vMoveForward(u8 A_u8Speed)
{
    HL298_vMotor1Forward();
    HL298_vMotor2Forward();
    HL298_vMotor3Forward();
    HL298_vMotor4Forward();

    HL298_vSetMotorSpeed(MOTOR1, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR2, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR3, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR4, A_u8Speed);
}


/* =========================================================
 * Backward
 * ========================================================= */

void HL298_vMoveBackward(u8 A_u8Speed)
{
    HL298_vMotor1Backward();
    HL298_vMotor2Backward();
    HL298_vMotor3Backward();
    HL298_vMotor4Backward();

    HL298_vSetMotorSpeed(MOTOR1, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR2, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR3, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR4, A_u8Speed);
}


/* =========================================================
 * Left
 * ========================================================= */

void HL298_vMoveLeft(u8 A_u8Speed)
{
    HL298_vMotor1Backward();
    HL298_vMotor2Forward();

    HL298_vMotor3Backward();
    HL298_vMotor4Forward();

    HL298_vSetMotorSpeed(MOTOR1, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR2, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR3, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR4, A_u8Speed);
}


/* =========================================================
 * Right
 * ========================================================= */

void HL298_vMoveRight(u8 A_u8Speed)
{
    HL298_vMotor1Forward();
    HL298_vMotor2Backward();

    HL298_vMotor3Forward();
    HL298_vMotor4Backward();

    HL298_vSetMotorSpeed(MOTOR1, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR2, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR3, A_u8Speed);
    HL298_vSetMotorSpeed(MOTOR4, A_u8Speed);
}


/* =========================================================
 * General Move Function
 * ========================================================= */

void HL298_vMove(u8 A_u8Direction, u8 A_u8Speed)
{
    switch(A_u8Direction)
    {
        case MOVE_FORWARD:

            HL298_vMoveForward(A_u8Speed);

            break;


        case MOVE_BACKWARD:

            HL298_vMoveBackward(A_u8Speed);

            break;


        case MOVE_LEFT:

            HL298_vMoveLeft(A_u8Speed);

            break;


        case MOVE_RIGHT:

            HL298_vMoveRight(A_u8Speed);

            break;


        case MOVE_STOP:

            HL298_vStop();

            break;


        default:

            HL298_vStop();

            break;
    }
}


/* =========================================================
 * Stop
 * ========================================================= */

void HL298_vStop(void)
{
    MGPIO_vSetPinValue(M1_IN1_PORT, M1_IN1_PIN, GPIO_LOW);
    MGPIO_vSetPinValue(M1_IN2_PORT, M1_IN2_PIN, GPIO_LOW);

    MGPIO_vSetPinValue(M2_IN1_PORT, M2_IN1_PIN, GPIO_LOW);
    MGPIO_vSetPinValue(M2_IN2_PORT, M2_IN2_PIN, GPIO_LOW);

    MGPIO_vSetPinValue(M3_IN1_PORT, M3_IN1_PIN, GPIO_LOW);
    MGPIO_vSetPinValue(M3_IN2_PORT, M3_IN2_PIN, GPIO_LOW);

    MGPIO_vSetPinValue(M4_IN1_PORT, M4_IN1_PIN, GPIO_LOW);
    MGPIO_vSetPinValue(M4_IN2_PORT, M4_IN2_PIN, GPIO_LOW);

    HL298_vSetMotorSpeed(MOTOR1, 0);
    HL298_vSetMotorSpeed(MOTOR2, 0);
    HL298_vSetMotorSpeed(MOTOR3, 0);
    HL298_vSetMotorSpeed(MOTOR4, 0);
}
