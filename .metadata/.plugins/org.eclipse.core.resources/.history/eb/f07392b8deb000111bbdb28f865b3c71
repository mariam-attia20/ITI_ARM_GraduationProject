#include "../LIB/STD_TYPES.h"
#include "../LIB/BIT_MATH.h"

#include "../HAL/blutooth/blutooth_int.h"


int main(void)
{
    HBLUETOOTH_vInit();

    HBLUETOOTH_vSendString((u8*)"Bluetooth Ready\r\n");

    while(1)
    {
        if(HBLUETOOTH_u8DataAvailable())
        {
            u8 L_u8Command = HBLUETOOTH_u8ReceiveChar();

            if(L_u8Command == 'F')
            {
                HBLUETOOTH_vSendString((u8*)"Forward\r\n");
            }
            else if(L_u8Command == 'B')
            {
                HBLUETOOTH_vSendString((u8*)"Backward\r\n");
            }
            else if(L_u8Command == 'L')
            {
                HBLUETOOTH_vSendString((u8*)"Left\r\n");
            }
            else if(L_u8Command == 'R')
            {
                HBLUETOOTH_vSendString((u8*)"Right\r\n");
            }
            else if(L_u8Command == 'S')
            {
                HBLUETOOTH_vSendString((u8*)"Stop\r\n");
            }
        }
    }
}
